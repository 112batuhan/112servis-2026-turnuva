# Project-wide environment. Copy to `.env` and fill in the blanks.
#
# One file, three consumers:
#   • Rust backend   — loaded via dotenvy, which searches parent directories, so
#                      `cargo run` from backend/ finds this file at the repo root.
#   • Vite frontend  — only VITE_-prefixed vars reach the browser (see envDir in
#                      frontend/vite.config.js); the secrets below are never bundled.
#   • docker-compose — variable substitution; compose sets DATABASE_URL and
#                      SERVER_ADDR itself, so those two are only used for local runs.

# osu! OAuth app — https://osu.ppy.sh/home/account/edit#oauth
OSU_CLIENT_ID=your_osu_client_id
OSU_CLIENT_SECRET=your_osu_client_secret
OSU_REDIRECT_URI=http://localhost:8080/auth/osu/callback

# Discord OAuth app, for optional account linking — https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:8080/auth/discord/callback

# Postgres connection; migrations run on startup. docker-compose points at its own
# `postgres` service, so this value only matters for a local `cargo run`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/discord_auth_starter

# --- Optional: the defaults below work for both local dev and Docker as-is. ---
#
# Backend listen address. Local default 127.0.0.1:8080; Docker uses 0.0.0.0:8080.
# SERVER_ADDR=127.0.0.1:8080
#
# Frontend origin for CORS + post-login redirect. Defaults to the Vite dev server
# (http://localhost:5173) locally; the Docker image serves the frontend from the
# backend, so it defaults to http://localhost:8080.
# FRONTEND_URL=http://localhost:5173
#
# Where the frontend calls the API. Unset ⇒ http://localhost:8080 for local dev;
# the Docker image builds it empty so the frontend uses its own origin.
# VITE_API_URL=http://localhost:8080
#
# Directory of a built frontend to serve as a SPA (the Docker image sets this).
# STATIC_DIR=./static
#
# Dev testing tools: a floating account switcher (sign in as any account without
# osu!) and seeding of dummy accounts/teams/invites (backend/seed/). One switch for
# both sides: the backend mounts /api/dev/* and the frontend bundles the switcher
# only when it's true (Docker: rebuild the image after changing it). Anyone who can
# reach the site can then sign in as any account, hosts included, so turn it off
# before the site goes public.
# DEV_LOGIN=false
#
# Bancho's IRC server for the referee page's chat (relayed by the backend, since
# browsers can't speak IRC). cho.ppy.sh:6667 is an alternative address.
# BANCHO_IRC_ADDR=irc.ppy.sh:6667
#
# Discord bot for the tournament server: roles, team announcements, private match
# channels, reminders, results and slash commands. Off unless both are set. Enable the
# "Server Members" intent on the bot's page and invite it with Administrator (or at
# least Manage Roles, Manage Channels, Manage Messages and Pin Messages (to pin each
# match channel's card), Create Invite, Send Messages, Embed Links),
# with its role above the roles it hands out. Everything else is set on /admin/discord.
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
#
# The ARG behind the navbar's trophy: three secret answers, entered in any order, each
# answered by its reply; the first to enter the third wins. Off unless all six are set.
# Answers match ignoring case and extra spaces (İ/I/ı/i count as one). A reply's
# {place} becomes the player's place among that answer's finders; use "\n" inside
# double quotes for a line break. Restart the backend after changing them.
# ARG_ANSWER_1=
# ARG_REPLY_1=
# ARG_ANSWER_2=
# ARG_REPLY_2=
# ARG_ANSWER_3=
# ARG_REPLY_3="You were #{place} to get here."
#
# Opens the ARG's results page at <backend>/api/kupa/results/<token>. Make it long and
# random (e.g. `openssl rand -hex 24`); unset, there's no results page.
# ARG_RESULTS_TOKEN=
